{
  "name": "la-ultima-observacion",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "npm run typecheck && vite build",
    "check": "npm run typecheck && npm run lint && npm test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:contracts": "vitest run tests/unit/contracts.worker.test.ts tests/unit/architecture-boundaries.test.ts",
    "validate:assets": "vitest run tests/unit/asset-validator.test.ts",
    "validate:tiles": "vitest run tests/unit/grammar-validator.test.ts",
    "typecheck": "tsc --noEmit --pretty false"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "0.19.3",
    "three": "0.185.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.1.2",
    "@types/three": "0.185.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "eslint": "10.8.0",
    "globals": "17.9.0",
    "prettier": "3.9.6",
    "typescript": "npm:@typescript/typescript6@6.0.3",
    "typescript-eslint": "8.66.0",
    "vite": "8.2.0",
    "vitest": "4.1.10"
  }
}

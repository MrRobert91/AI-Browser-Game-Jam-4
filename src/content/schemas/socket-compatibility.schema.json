{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "socket-compatibility.schema.json",
  "title": "SocketCompatibilityDocument",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "sockets"],
  "properties": {
    "version": { "const": 1 },
    "sockets": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": { "type": "string", "minLength": 1 }
      }
    }
  }
}
